#--------------------------------------------------------------------
# WBS Platform — environment template
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`
# (it is gitignored). Secrets below are placeholders only.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
# In production set forceGlobalSecureRequests = true (HTTPS only).
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

# --- Primary database (MySQL 8 / MariaDB, utf8mb4, UTC) ---
database.default.hostname = 127.0.0.1
database.default.database = wbs_platform
database.default.username = CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# --- Test database (used by the PHPUnit suite) ---
database.tests.hostname = 127.0.0.1
database.tests.database = wbs_platform_test
database.tests.username = CHANGE_ME
database.tests.password = CHANGE_ME
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

# --- Redis (cache, locks, rate limiting, ephemeral realtime) ---
redis.host = 127.0.0.1
redis.port = 6379
redis.password =
redis.database = 0

# --- Encryption (libsodium envelope master key) ---
# Generate a fresh 32-byte key, e.g.:
#   php -r "echo 'hex2bin:'.bin2hex(sodium_crypto_secretbox_keygen()).PHP_EOL;"
# In production load this from a KMS / secret store, not a file.
encryption.key = hex2bin:REPLACE_WITH_32_BYTE_HEX_KEY

# --- Key management provider (Tier 1 seam) ---
# KEY_PROVIDER selects the custody model; all options satisfy the same
# KeyProvider seam so no application code changes. See
# docs/SECRETS_KEY_MANAGEMENT_OPTIONS.md.
#   env       (default) — data key from encryption.key above (Option A)
#   envelope            — envelope encryption: a managed KEK unwraps per-epoch
#                         DEKs (Options B/C/D). Set the vars below.
# KEY_PROVIDER = env
#
# When KEY_PROVIDER=envelope:
#   KEY_KEK          unwrapper backend: local (offline) | aws-kms | gcp-kms |
#                    azure-kv | vault. Cloud backends are drop-in KekUnwrappers.
#   KEY_ACTIVE_ID    keyId tagged onto new ciphertext (e.g. k1, then k2 to rotate)
#   KEY_WRAPPED_DEKS keyId=wrappedDEK map, comma-separated; keep old epochs so
#                    historical blobs still decrypt (no re-encryption needed):
#                      KEY_WRAPPED_DEKS = k1=BASE64_WRAPPED_DEK_V1,k2=BASE64_WRAPPED_DEK_V2
#   KEK_MATERIAL     KEK bytes for the `local` backend ONLY (hex2bin:/raw-32);
#                    cloud backends never expose the KEK to the app.
# KEY_KEK = local
# KEY_ACTIVE_ID = k1
# KEY_WRAPPED_DEKS =
# KEK_MATERIAL = hex2bin:REPLACE_WITH_32_BYTE_HEX_KEK

# --- Organization guardrails (single-org; FR-GAM-006 / §17.3) ---
# The whole app resolves this fixed org id. The RBAC seeder seeds the org
# with EXACTLY this id, so runtime and seed data agree. Change only on a
# fresh database, then re-seed.
wbs.organizationId = 00000000-0000-7000-8000-000000000001
wbs.organizationTimezone = Africa/Accra
wbs.maxGroupDepth = 9

# --- AccessControl delegation (SRS FR-ACL-005) ---
# Maximum delegation-chain depth: a role/direct grant delegates at depth 1, a
# sub-delegation at parent depth + 1. Delegations deeper than this are refused.
# acl.maxDelegationDepth = 3

# --- Notification transports (real outbound I/O; FR-NOT-*/FR-INT-012) ---
# Email is the reference channel transport: a transactional email provider's
# HTTP send API (SendGrid/Mailgun/Postmark/SES-style JSON). Unset = the email
# transport treats sends as a transient failure and the queue retries (it never
# silently marks mail "sent"). In-app needs no config.
# EMAIL_API_BASE_URL = https://api.sendgrid.com/v3
# EMAIL_API_KEY = REPLACE_ME
# EMAIL_FROM_ADDRESS = no-reply@example.org
# EMAIL_FROM_NAME = Win-Build-Send
#
# SMS is a CHAIN of two Ghana-first aggregators: mNotify PRIMARY, Nalo Solutions
# FALLBACK. Reorder (or drop to one) with SMS_PROVIDER_ORDER. Failover happens on
# a provider FAULT only (5xx/timeout/rate-limit/credentials/credit) — never on a
# permanent per-message rejection (bad number, unapproved sender ID), which the
# next provider would refuse too. A provider with no credentials is SKIPPED, not
# attempted; if NONE is configured the channel reports a TRANSIENT failure and the
# queue retries (an SMS is never silently marked "sent").
# SMS_PROVIDER_ORDER = mnotify,nalo
#
# PER-GROUP CREDENTIALS. The keys below are the PLATFORM bootstrap and back
# org-wide accounts. A hierarchical body's own key and sender ID live in the
# encrypted credential vault instead, entered by its leader at
# /notifications/credentials, and sharing down a subtree is an explicit grant.
# A body with neither its own credential nor a grant covering it is REFUSED:
# its messages are never sent on the keys below. A body may also declare its own
# provider order on its connection (settings.provider_order), which overrides
# SMS_PROVIDER_ORDER for that body's sends.
#
# mNotify/BMS "Quick Bulk SMS" (https://api.mnotify.com/api/sms/quick).
# The API key is sent as ?key=..., so it must stay out of client-visible URLs and
# logs.
# MNOTIFY_API_KEY = REPLACE_ME            # or SMS_API_KEY
# SMS_API_BASE_URL = https://api.mnotify.com
# Registered alphanumeric sender ID (must be approved by mNotify first).
# SMS_SENDER_ID = REPLACE_ME
# Used to rewrite +233XXXXXXXXX into the local 0XXXXXXXXX form mNotify samples.
# SMS_DEFAULT_COUNTRY_CODE = 233
#
# Nalo Solutions reseller SMS — the fallback. Form-encoded POST; credentials are
# either a reseller username+password OR a single auth key. Recipients go in
# INTERNATIONAL form (233XXXXXXXXX: no "+" and no leading 0). Sender IDs are
# approved separately in the Nalo portal (max 11 characters), so they get their
# own variable and fall back to SMS_SENDER_ID when unset.
# NALO_SMS_USERNAME = REPLACE_ME
# NALO_SMS_PASSWORD = REPLACE_ME
# NALO_SMS_AUTH_KEY =                     # single-key accounts (sent as auth_key)
# NALO_SMS_SENDER_ID = REPLACE_ME
# Reseller endpoints differ between account types — both are overridable:
# NALO_SMS_API_BASE_URL = https://api.nalosolutions.com
# NALO_SMS_API_PATH = /smsbackend/clientapi/ResellerAPI/send_sms/

# --- Signing / secret keys (behaviour differs — read carefully) ---
# QR check-in nonce HMAC key (FR-EVT-007/008).
#   OPTIONAL: if unset, check-in still works using a dev default key that is
#   PUBLIC in the source. Set a strong random value in production, e.g.:
#     php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"   (or: openssl rand -hex 32)
# CHECKIN_SIGNING_KEY = REPLACE_ME
#
# Payment webhook HMAC secret (FR-VBCS-006).
#   NO DEFAULT — the verifier is FAIL-CLOSED: if unset (empty), EVERY inbound
#   payment webhook is REJECTED (payments won't confirm). REQUIRED in any
#   environment that accepts real provider callbacks. The value is the exact
#   secret configured on the PROVIDER's side (e.g. Stripe endpoint signing
#   secret) — copy it from the provider, do not invent it.
#   Per-provider key (dotted, wins for that provider) preferred; WEBHOOK_SECRET
#   is the global fallback for providers without a specific entry.
# webhook.secret.stripe = REPLACE_ME
# WEBHOOK_SECRET = REPLACE_ME
