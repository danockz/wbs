{
  "name": "wbs-platform",
  "private": true,
  "description": "Frontend build: Tailwind v4 + hashed CSS/JS for layouts/app.php",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./public/assets/css/app.css --minify",
    "build:js": "node tools/hash-assets.mjs",
    "build": "npm run build:css && node tools/hash-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^4.1.13"
  }
}
